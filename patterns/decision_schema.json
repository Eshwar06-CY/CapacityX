{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrandsDecider2BDecisionSchema",
  "description": "Standardized input and output contract for the Strands Decider 2B logistics decision pattern using typed tool selection.",
  "definitions": {
    "IncidentInput": {
      "type": "object",
      "required": [
        "shipment_id",
        "delivery_deadline",
        "truck_breakdown",
        "replacement_vehicle_available",
        "customer_notified"
      ],
      "properties": {
        "shipment_id": {
          "type": "string",
          "description": "Unique identifier for the shipment."
        },
        "delivery_deadline": {
          "type": "string",
          "description": "ISO 8601 target delivery timestamp."
        },
        "truck_breakdown": {
          "type": "boolean",
          "description": "Whether the primary vehicle is immobilized or impaired."
        },
        "breakdown_severity": {
          "type": "string",
          "enum": ["NONE", "LOW", "MODERATE", "CRITICAL"]
        },
        "replacement_vehicle_available": {
          "type": "boolean",
          "description": "Whether an alternate vehicle is accessible within service range."
        },
        "customer_notified": {
          "type": "boolean",
          "description": "Whether customer has already been alerted of this event."
        },
        "cargo_type": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "estimated_distance_remaining_km": {
          "type": "number"
        }
      }
    },
    "DeciderOutput": {
      "type": "object",
      "required": [
        "selected_action",
        "action_type",
        "urgency",
        "headline",
        "rationale",
        "estimated_delay_minutes",
        "deadline_met_projected",
        "sla_risk_level",
        "human_review_required",
        "engine",
        "is_real_model"
      ],
      "properties": {
        "selected_action": {
          "type": "string",
          "description": "The typed decision tool selected among the 5 predefined choices.",
          "enum": [
            "dispatch_replacement",
            "reroute_shipment",
            "crossdock",
            "escalate_to_human",
            "continue_monitoring"
          ]
        },
        "action_type": {
          "type": "string",
          "description": "Normalized action descriptor for dashboard compatibility."
        },
        "model_confidence": {
          "type": ["number", "null"],
          "description": "Calibrated probability score between 0.0 and 1.0 from Strands Decider 2B."
        },
        "alternatives": {
          "type": "object",
          "description": "Probabilistic distribution across all alternative decision options.",
          "additionalProperties": { "type": "number" }
        },
        "human_review_required": {
          "type": "boolean",
          "description": "True if confidence is below threshold, model is unavailable, or risk warrants human confirmation."
        },
        "engine": {
          "type": "string",
          "description": "Identifies whether the decision was generated by the real model or safe fallback.",
          "enum": ["STRANDS_DECIDER_2B_REAL", "AMAZON_BEDROCK_NOVA_MICRO", "SAFE_FALLBACK"]
        },
        "is_real_model": {
          "type": "boolean",
          "description": "Strict flag indicating if the output is from the live Decider 2B model."
        },
        "fallback_reason": {
          "type": ["string", "null"],
          "description": "Reason for safe fallback invocation if model was not reached or failed."
        },
        "model_id": {
          "type": "string",
          "description": "Checkpoint identifier (e.g. StrandsAgents/strands-decider-2B-qwen3.5-v1-2610)."
        },
        "urgency": {
          "type": "string",
          "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
        },
        "headline": {
          "type": "string"
        },
        "rationale": {
          "type": "array",
          "items": { "type": "string" }
        },
        "estimated_delay_minutes": {
          "type": "integer"
        },
        "deadline_met_projected": {
          "type": "boolean"
        },
        "sla_risk_level": {
          "type": "string",
          "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL_BREACH"]
        },
        "customer_action_required": {
          "type": "boolean"
        },
        "is_simulated": {
          "type": "boolean"
        },
        "bedrock_validation": {
          "type": "object",
          "description": "Optional complementary operational reasoning from Amazon Bedrock Nova Micro.",
          "properties": {
            "status": { "type": "string" },
            "is_simulated": { "type": "boolean" },
            "operational_validation": { "type": "boolean" },
            "operational_notes": { "type": "array", "items": { "type": "string" } },
            "recommended_precautions": { "type": "array", "items": { "type": "string" } },
            "model_id": { "type": "string" },
            "disclaimer": { "type": "string" },
            "error_reason": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
