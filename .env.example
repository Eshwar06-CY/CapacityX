# ==============================================================================
# CAPACITYX Consolidated Environment Configuration Template
# Copy this file to .env at the project root. NEVER commit your private .env!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite Client Application)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend API service.
# Exposed safely to the React dashboard via Vite (only VITE_* variables are bundled).
VITE_API_BASE_URL=http://127.0.0.1:8081

# ------------------------------------------------------------------------------
# 2. STRANDS DECIDER 2B (PRIMARY DECISION ENGINE - SYSTEM 1)
# ------------------------------------------------------------------------------
# Hosted CloudFront Mode (Official Hackathon API):
DECIDER_MODE=ugmdu
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY=your_decider_api_key_here

# Local / Self-Hosted GPU Server Mode (Optional):
# Used ONLY if DECIDER_API_KEY is unset and you are running your own decider server.
# STRANDS_DECIDER_URL=http://127.0.0.1:8099
# STRANDS_DECIDER_USERNAME=
# STRANDS_DECIDER_PASSWORD=

# ------------------------------------------------------------------------------
# 3. AMAZON BEDROCK NOVA MICRO (OPERATIONAL REASONING - SYSTEM 2 - OPTIONAL)
# ------------------------------------------------------------------------------
# Bedrock is DISABLED by default (false). Zero AWS calls are made unless enabled.
CAPACITYX_ENABLE_BEDROCK=false

# Bedrock Mode: "disabled" | "mock" (offline simulation) | "live" (requires verified AWS account)
CAPACITYX_BEDROCK_MODE=disabled

# AWS Configuration (Used only if CAPACITYX_ENABLE_BEDROCK=true and CAPACITYX_BEDROCK_MODE=live)
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
